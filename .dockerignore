# =============================================================================
# Recrutva — Docker Ignore
# =============================================================================

# Dependencies
node_modules
.pnp
.pnp.*
.yarn

# Next.js build output (we build inside Docker)
.next
out
build

# Environment files (secrets are passed at runtime)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Version control
.git
.gitignore

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Testing
coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker files (don't include in context)
Dockerfile
docker-compose*.yml
.dockerignore

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Clerk configuration (can include secrets)
.clerk

# Drizzle kit generated files
/lib/generated/prisma

# README and documentation
README.md

# Misc
*.pem
