# =============================================================================
# Recrutva Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────────────────
# Database (Neon PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# The pooled connection string from the Neon console, e.g.
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# The same variable is used in development and production — there is no
# separate variable for each environment. TLS is implicit for the Neon HTTP
# driver, so `sslmode` is optional here (it only matters for drizzle-kit and
# node-postgres). Never commit a real value.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Clerk Authentication
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Groq AI
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary (file uploads)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
# Local Docker development (provided by docker-compose.yml):
#   REDIS_URL=redis://redis:6379
#   REDIS_TOKEN is not required for local Redis
#
# Production (Upstash):
#   REDIS_URL=https://xxx.upstash.io
#   REDIS_TOKEN=AXxx...
#
# Get Upstash credentials from: https://console.upstash.com
REDIS_URL=
REDIS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Email (Nodemailer / SMTP)
# ─────────────────────────────────────────────────────────────────────────────
# SMTP_* variables are the preferred configuration. EMAIL_USER / EMAIL_PASS are
# the legacy Gmail-style fallback. Credentials come from your environment only
# — never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Public base URL — used in all email links and reminders
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: protects /api/cron/reminders from public abuse.
# When set, cron calls must send `Authorization: Bearer <value>`.
CRON_SECRET=
